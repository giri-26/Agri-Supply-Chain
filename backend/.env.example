# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000

# Set this to your machine's LAN IP so the server binds and logs correctly.
# Find it with `ipconfig` (Windows) or `ifconfig` / `ip addr` (Mac/Linux).
SERVER_LOCAL_IP=192.168.1.10

# Comma-separated list of allowed frontend origins (LAN IPs + localhost)
CORS_ORIGINS=http://localhost:5173,http://192.168.1.10:5173

# ==========================================
# DATABASE (PostgreSQL - local, no cloud)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agri_supply_chain
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_this_with_a_long_random_string_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ==========================================
# BCRYPT
# ==========================================
BCRYPT_SALT_ROUNDS=12

# ==========================================
# FILE UPLOADS
# ==========================================
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
